# Core Supabase configuration
# Found in: Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Transactional email via Resend
# Required for server-side email sending from /api/send-offerte
# Found in: https://resend.com/api-keys
RESEND_API_KEY=re_your-api-key-here
RESEND_FROM_EMAIL=offerte@offertio.ch

# Rate limiting via Upstash Redis
# Recommended in production
# Found in: Upstash Console -> Database -> REST API
UPSTASH_REDIS_REST_URL=https://your-redis.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-token-here

# Lemon Squeezy checkout URLs
# Optional until paid plans go live
# Found in: Lemon Squeezy -> Products -> Variants -> Checkout URL
NEXT_PUBLIC_LS_PRO_MONTHLY=https://offertio.lemonsqueezy.com/checkout/buy/your-monthly-variant-id
NEXT_PUBLIC_LS_PRO_YEARLY=https://offertio.lemonsqueezy.com/checkout/buy/your-yearly-variant-id
NEXT_PUBLIC_LS_EARLY_MONTHLY=https://offertio.lemonsqueezy.com/checkout/buy/your-early-monthly-variant-id
NEXT_PUBLIC_LS_EARLY_YEARLY=https://offertio.lemonsqueezy.com/checkout/buy/your-early-yearly-variant-id

# Lemon Squeezy webhook verification
# Found in: Lemon Squeezy -> Settings -> Webhooks
LEMON_SQUEEZY_WEBHOOK_SECRET=your-webhook-secret-here

# Optional analytics
NEXT_PUBLIC_GA4_MEASUREMENT_ID=G-XXXXXXXXXX
NEXT_PUBLIC_META_PIXEL_ID=123456789012345

# Optional auth UX
# Set to true only if Google OAuth is configured in Supabase Auth
NEXT_PUBLIC_GOOGLE_AUTH_ENABLED=false
