# Canonical public site. Apex is canonical; www.getoffertio.ch redirects to it.
# Also set this in Vercel for production and in Supabase Auth redirect URLs.
NEXT_PUBLIC_SITE_URL=https://getoffertio.ch

# Core Supabase configuration
# Found in: Supabase Dashboard -> Project Settings -> API
# Create the project in region eu-central-2 (Zurich). Do not use a US region.
# Personal data (profiles, documents, storage) stays in Switzerland (nDSG).
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Transactional email via Resend (EU)
# Required for server-side email sending from /api/send-offerte
# Dashboard: create the API key in the EU region (eu-west-1, Ireland).
# Resend has no Zurich region. The key itself selects the region;
# the default API host remains https://api.resend.com.
# Verify the sending domain getoffertio.ch in that same EU region.
# Found in: https://resend.com/api-keys
RESEND_API_KEY=re_your-api-key-here
RESEND_FROM_EMAIL=offerte@getoffertio.ch
# Optional. Leave unset unless Resend gives this key a dedicated EU base URL.
# RESEND_API_BASE_URL=https://api.resend.com

# Rate limiting via Upstash Redis
# Recommended in production. Prefer an EU database if Upstash offers a region choice.
# Found in: Upstash Console -> Database -> REST API
UPSTASH_REDIS_REST_URL=https://your-redis.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-token-here

# Stripe Checkout — one-time Gründerplatz (Lifetime), CHF 249
# Optional until paid checkout goes live. Without these, the upgrade UI
# stays visible and checkout stays disabled.
# STRIPE_SECRET_KEY: Developers -> API keys -> Secret key (sk_test_... or sk_live_...)
# STRIPE_WEBHOOK_SECRET: Developers -> Webhooks -> signing secret (whsec_...)
#   Endpoint: https://getoffertio.ch/api/webhooks/stripe
#   Events: checkout.session.completed, checkout.session.async_payment_succeeded,
#           checkout.session.expired
# STRIPE_LIFETIME_PRICE_ID: optional Price id (price_...) for a one-time CHF 249 price.
#   Leave empty to let Checkout create the price inline.
# STRIPE_FOUNDER_SEAT_LIMIT: max confirmed Gründerplätze. Default 20. Set 0 to disable the cap.
# Enable Cards and TWINT (Settings -> Payment methods). TWINT is CHF-only.
# If TWINT is not activated, checkout continues with card only.
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
STRIPE_LIFETIME_PRICE_ID=
STRIPE_FOUNDER_SEAT_LIMIT=20

# Optional analytics
NEXT_PUBLIC_GA4_MEASUREMENT_ID=G-XXXXXXXXXX
NEXT_PUBLIC_META_PIXEL_ID=123456789012345

# Optional auth UX
# Set to true only if Google OAuth is configured in Supabase Auth
NEXT_PUBLIC_GOOGLE_AUTH_ENABLED=false

# Public-view signing flow (recipient signs offer in browser)
# Off by default: the legal weight of a drawn signature without identity
# verification is thin. Turn on only after consent + email-verify are wired.
# When off, both the UI controls and the /api/public/sign + /reject endpoints
# behave as if the feature does not exist.
NEXT_PUBLIC_ENABLE_SIGNING=false


# Optional analytics
NEXT_PUBLIC_GA4_MEASUREMENT_ID=G-XXXXXXXXXX
NEXT_PUBLIC_META_PIXEL_ID=123456789012345

# Optional auth UX
# Set to true only if Google OAuth is configured in Supabase Auth
NEXT_PUBLIC_GOOGLE_AUTH_ENABLED=false

# Public-view signing flow (recipient signs offer in browser)
# Off by default: the legal weight of a drawn signature without identity
# verification is thin. Turn on only after consent + email-verify are wired.
# When off, both the UI controls and the /api/public/sign + /reject endpoints
# behave as if the feature does not exist.
NEXT_PUBLIC_ENABLE_SIGNING=false
